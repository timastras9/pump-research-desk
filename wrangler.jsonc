{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pump-research-desk",
  "account_id": "0fc41c21a6be19f1c763c87e03a4ae0b",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "DESK", "class_name": "ResearchDesk" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ResearchDesk"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
